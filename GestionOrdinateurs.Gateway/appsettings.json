{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:5010"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "routeOrdinateurs": {
        "ClusterId": "gestionOrdinateursApi",
        "Match": { "Path": "/api/ordinateurs/{**catch-all}" }
      },
      "routeReparations": {
        "ClusterId": "gestionOrdinateursApi",
        "Match": { "Path": "/api/reparation/{**catch-all}" }
      },
      "routeAuthentification": {
        "ClusterId": "authentificationApi",
        "Match": { "Path": "/api/authentication/{**catch-all}" }
      }
    },
    "Clusters": {
      "gestionOrdinateursApi": {
        "Destinations": {
          "gestionOrdinateursService": { "Address": "http://localhost:5102/" }
        }
      },
      "authentificationApi": {
        "Destinations": {
          "authentificationService": { "Address": "http://localhost:5150/" }
        }
      }
    }
  }
}