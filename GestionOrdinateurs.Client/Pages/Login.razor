@page "/login"
@using System.Net
@using GestionOrdinateurs.Shared

@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage
@inject NavigationManager Navigation
@inject JwtAuthenticationStateProvider AuthProvider

<PageTitle>Connexion</PageTitle>

<h3>Connexion</h3>

<InputText @bind-Value="UsernameSaisi" class="form-control" placeholder="Utilisateur (ex : user1)" />
<InputText @bind-Value="PasswordSaisi" type="password" class="form-control mt-2" placeholder="Mot de passe" />

<button class="btn btn-primary mt-2" @onclick="SeConnecter">
    Connecter
</button>

@if (!string.IsNullOrEmpty(MessageErreur))
{
    <div class="alert alert-danger mt-2">@MessageErreur</div>
}

@code
{

    private string UsernameSaisi = "";
    private string PasswordSaisi = "";

    
    private string? MessageErreur;

    private async Task SeConnecter()
    {
        MessageErreur = null;

        if (string.IsNullOrWhiteSpace(UsernameSaisi) || string.IsNullOrWhiteSpace(PasswordSaisi))
        {
            MessageErreur = "Veuillez saisir l'utilisateur et le mot de passe.";
            return;
        }

    
        var client = HttpClientFactory.CreateClient("AuthApi");
        var reponse = await client.PostAsJsonAsync("Authentication/login-keycloak",
            new KeycloakLoginRequest(UsernameSaisi, PasswordSaisi));

    
        if (reponse.StatusCode == HttpStatusCode.Unauthorized)
        {
            MessageErreur = "Identifiant ou mot de passe incorrect.";
            return;
        }

        if (!reponse.IsSuccessStatusCode)
        {
            MessageErreur = "Erreur lors de la connexion.";
            return;
        }

    
        var tokenResponse = await reponse.Content.ReadFromJsonAsync<TokenResponse>();
        if (tokenResponse == null)
        {
            MessageErreur = "Réponse invalide du serveur.";
            return;
        }

        await SessionStorage.SetItemAsync("jwtToken", tokenResponse.AccessToken);
        AuthProvider.NotifyUserAuthentication(tokenResponse.AccessToken);
        Navigation.NavigateTo("/");
    }
}